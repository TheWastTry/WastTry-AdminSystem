# ==========================================================
# WastTry ADMIN SYSTEM
# Minecraft 1.21.11
# Skript 2.16.2
# OP GEREKMEZ
# ==========================================================

options:
    admin-1: WastTry
    admin-2: KGAMEOVER
    maintenance-owner: WastTry
    max-team-size: 5
    admin-max-distance: 10

# ==========================================================
# ADMIN KONTROL
# ==========================================================

function isAdmin(p: player) :: boolean:
    if {_p}'s name is "{@admin-1}":
        return true
    if {_p}'s name is "{@admin-2}":
        return true
    return false

function isMaintenanceOwner(p: player) :: boolean:
    if {_p}'s name is "{@maintenance-owner}":
        return true
    return false

# ==========================================================
# CHAT RENKLERİ
# ==========================================================

function getChatColor(color: text) :: text:
    if {_color} is "red":
        return "&c"
    if {_color} is "gold":
        return "&6"
    if {_color} is "yellow":
        return "&e"
    if {_color} is "green":
        return "&a"
    if {_color} is "dark_green":
        return "&2"
    if {_color} is "aqua":
        return "&b"
    if {_color} is "blue":
        return "&9"
    if {_color} is "dark_purple":
        return "&5"
    if {_color} is "light_purple":
        return "&d"
    if {_color} is "white":
        return "&f"
    return "&a"

# ==========================================================
# CHAT
# ==========================================================

on chat:

    # MUTE
    if {muted.%player's uuid%} is true:
        if isAdmin(player) is false:
            cancel event
            send "&c&lMUTE &8» &fSusturuldun, chat kullanamazsın." to player
            play sound "entity.villager.no" with volume 1 and pitch 1 to player
            stop

    # BAKIM OYUNCU EKLE
    if {maintenance.input.%player's uuid%} is true:
        cancel event

        if isMaintenanceOwner(player) is false:
            delete {maintenance.input.%player's uuid%}
            stop

        if message is "iptal":
            delete {maintenance.input.%player's uuid%}
            send "&c✖ İşlem iptal edildi." to player
            stop

        execute console command "whitelist add %message%"
        delete {maintenance.input.%player's uuid%}

        send "" to player
        send "&a&l✔ OYUNCU WHITELIST'E EKLENDİ" to player
        send "&7» Oyuncu: &f%message%" to player
        send "" to player

        play sound "block.note_block.pling" with volume 1 and pitch 1.2 to player
        stop

    # TAKIM GİRİŞLERİ
    if {team.input.%player's uuid%} is set:
        cancel event

        if message is "iptal":
            delete {team.input.%player's uuid%}
            send "&c✖ İşlem iptal edildi." to player
            stop

        # TAKIM ADI
        if {team.input.%player's uuid%} is "name":

            if {team.%player's uuid%} is not set:
                delete {team.input.%player's uuid%}
                stop

            if length of message < 2:
                send "&c✖ Takım adı en az 2 karakter olmalı." to player
                stop

            if length of message > 8:
                send "&c✖ Takım adı en fazla 8 karakter olabilir." to player
                stop

            set {_team} to {team.%player's uuid%}
            set {team.name.%{_team}%} to message
            delete {team.input.%player's uuid%}

            send "&a✔ Takım adı &f%message% &aolarak ayarlandı." to player
            play sound "block.note_block.pling" with volume 1 and pitch 1.2 to player
            stop

        # TAKIM DAVET
        if {team.input.%player's uuid%} is "invite":

            if {team.%player's uuid%} is not set:
                delete {team.input.%player's uuid%}
                send "&c✖ Önce bir takım oluşturmalısın." to player
                stop

            set {_target} to none

            loop all players:
                if loop-player's name is message:
                    set {_target} to loop-player

            if {_target} is none:
                send "&c✖ Bu oyuncu çevrimiçi değil." to player
                stop

            if {_target}'s uuid is player's uuid:
                send "&c✖ Kendini davet edemezsin." to player
                stop

            set {_team} to {team.%player's uuid%}

            if size of {team.members.%{_team}%::*} >= {@max-team-size}:
                send "&c✖ Takım maksimum {@max-team-size} kişi olabilir." to player
                delete {team.input.%player's uuid%}
                stop

            if {team.%{_target}'s uuid%} is set:
                send "&c✖ Bu oyuncunun zaten bir takımı var." to player
                delete {team.input.%player's uuid%}
                stop

            set {team.invite.%{_target}'s uuid%} to {_team}
            delete {team.input.%player's uuid%}

            send "&a✔ &f%{_target}'s name% &atakıma davet edildi." to player

            send "" to {_target}
            send "&a&l⚔ TAKIM DAVETİ" to {_target}
            send "&7» &f%player's name% &7seni &e%{team.name.%{_team}%}% &7takımına davet etti." to {_target}
            send "&7» Kabul etmek için &a/takımkabul &7yaz." to {_target}
            send "" to {_target}

            play sound "entity.experience_orb.pickup" with volume 1 and pitch 1.2 to {_target}
            stop

    # ADMIN OYUNCU SEÇME
    if {admin.active.%player%} is true:
        if isAdmin(player) is true:

            loop all players:
                if loop-player's name is message:

                    cancel event

                    set {admin.target.%player%} to loop-player

                    teleport player to loop-player

                    send title "&c&l⚡ OYUNCU SEÇİLDİ ⚡" with subtitle "&f★ %loop-player's name% ★" to player for 5 ticks, 30 ticks, 10 ticks

                    play sound "entity.enderman.teleport" with volume 1 and pitch 1 to player

                    send "&f★ %loop-player's name% &7adlı oyuncuya ışınlandın." to player
                    send "&7⚡ Maksimum uzaklık: &f{@admin-max-distance} blok." to player

                    stop

    # TAKIM CHAT
    if {team.%player's uuid%} is set:

        set {_team} to {team.%player's uuid%}
        set {_teamname} to {team.name.%{_team}%}
        set {_color} to {team.color.%{_team}%}

        if {_teamname} is not set:
            set {_teamname} to "TAKIM"

        if {_color} is not set:
            set {_color} to "green"

        set {_chatcolor} to getChatColor({_color})

        set chat format to "%{_chatcolor}%%{_teamname}% &8- &f%player% &8» &f%message%"

# ==========================================================
# /ADMIN
# ==========================================================

command /admin:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if {admin.active.%player%} is true:
            send "&e⚠ Zaten admin modundasın!" to player
            stop

        set {admin.return.%player%} to location of player
        set {admin.gamemode.%player%} to player's gamemode
        set {admin.active.%player%} to true

        set player's gamemode to spectator

        hide player from all players

        send title "&c&l⚡ ADMIN MODU ⚡" with subtitle "&f★ Oyuncu seç ★" to player for 10 ticks, 40 ticks, 10 ticks

        play sound "block.beacon.activate" with volume 1 and pitch 1 to player

        send ""
        send "&8&m━━━━━━━━━━━━━━━━━━━━━━━━"
        send "&c&l⚡ ADMIN MODU"
        send ""
        send "&7» İzlemek istediğin oyuncunun ismini chat'e yaz."
        send ""
        send "&e&l★ Online Oyuncular:"

        loop all players:
            send "&8• &f%loop-player's name%" to player

        send ""
        send "&7⚡ Maksimum uzaklık: &f{@admin-max-distance} blok"
        send "&7» Çıkmak için &c/adminleave"
        send "&8&m━━━━━━━━━━━━━━━━━━━━━━━━"

# ==========================================================
# ADMIN HAREKET
# ==========================================================

on player move:

    if {admin.active.%player%} is true:

        if {admin.target.%player%} is not set:
            cancel event
            stop

        if {admin.target.%player%} is not online:

            delete {admin.target.%player%}

            send "&e⚠ Takip ettiğin oyuncu oyundan ayrıldı." to player
            send "&7» Yeni bir oyuncunun ismini chat'e yaz." to player

# ==========================================================
# ADMIN TAKİP
# ==========================================================

every 5 ticks:

    loop all players:

        if {admin.active.%loop-player%} is true:

            if {admin.target.%loop-player%} is set:

                if {admin.target.%loop-player%} is online:

                    set {_target} to {admin.target.%loop-player%}
                    set {_distance} to distance between loop-player and {_target}

                    if {_distance} > {@admin-max-distance}:

                        teleport loop-player to {_target}

                        send action bar "&c&l⚡ ADMIN &8| &fOyuncu: &e%{_target}'s name% &8| &cUZAK!" to loop-player

                    else:

                        send action bar "&c&l⚡ ADMIN &8| &fOyuncu: &e%{_target}'s name% &8| &fUzaklık: &e%{_distance}% blok" to loop-player

# ==========================================================
# /ADMINUYARI
# ==========================================================

command /adminuyarı <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if player's name is "{@admin-2}":

            if {admin.warning.cooldown.%player%} is set:
                send "&e⚠ Bu komutu tekrar kullanmak için beklemelisin." to player
                send "&7» Kalan süre: &e%{admin.warning.cooldown.%player%}%" to player
                stop

            set {admin.warning.cooldown.%player%} to 5 minutes

        send "&c&l⚡ UYARI GÖNDERİLDİ &8» &f%arg-player's name%" to player

        send title "&c&lADMİNDEN BİR UYARI ALDIN!" with subtitle "&f⚠ Bir daha yapma!" to arg-player for 10 ticks, 60 ticks, 20 ticks

        play sound "entity.lightning_bolt.thunder" with volume 1 and pitch 1 to arg-player

# ==========================================================
# UYARI COOLDOWN
# ==========================================================

every 1 second:

    loop all players:

        if {admin.warning.cooldown.%loop-player%} is set:

            remove 1 second from {admin.warning.cooldown.%loop-player%}

            if {admin.warning.cooldown.%loop-player%} <= 0 seconds:
                delete {admin.warning.cooldown.%loop-player%}

# ==========================================================
# /ADMINLEAVE
# ==========================================================

command /adminleave:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if {admin.active.%player%} is not true:
            send "&e⚠ Admin modunda değilsin!" to player
            stop

        reveal player to all players

        if {admin.return.%player%} is set:
            teleport player to {admin.return.%player%}

        if {admin.gamemode.%player%} is set:
            set player's gamemode to {admin.gamemode.%player%}

        delete {admin.active.%player%}
        delete {admin.return.%player%}
        delete {admin.gamemode.%player%}
        delete {admin.target.%player%}

        send title "&c&l⚡ ADMIN MODUNDAN ÇIKTIN ⚡" with subtitle "&f★ Eski konumuna döndün ★" to player for 5 ticks, 30 ticks, 10 ticks

        play sound "block.beacon.deactivate" with volume 1 and pitch 1 to player

# ==========================================================
# /MUTE
# ==========================================================

command /mute <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if arg-player is player:
            send "&c✖ Kendini susturamazsın!" to player
            stop

        if {muted.%arg-player's uuid%} is true:
            send "&e⚠ %arg-player's name% zaten susturulmuş." to player
            stop

        set {muted.%arg-player's uuid%} to true

        send "&c&lMUTE &8» &f%arg-player's name% &7susturuldu." to player
        send "&c&lMUTE &8» &7Artık chat kullanamazsın." to arg-player

# ==========================================================
# /UNMUTE
# ==========================================================

command /unmute <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if {muted.%arg-player's uuid%} is not true:
            send "&e⚠ %arg-player's name% zaten susturulmamış." to player
            stop

        delete {muted.%arg-player's uuid%}

        send "&c&lMUTE &8» &f%arg-player's name% &7artık susturulmuş değil." to player
        send "&c&lMUTE &8» &7Tekrar chat kullanabilirsin." to arg-player

# ==========================================================
# /TAKIM
# ==========================================================

command /takım:
    executable by: players

    trigger:

        open chest inventory with 3 rows named "&8⚔ Takım Menüsü" to player

        wait 1 tick

        if {team.%player's uuid%} is set:

            set {_team} to {team.%player's uuid%}
            set {_teamname} to {team.name.%{_team}%}

            if {_teamname} is not set:
                set {_teamname} to "TAKIM"

            set slot 10 of player's current inventory to emerald named "&a&l⚔ TAKIMIM" with lore "&7Takım: &f%{_teamname}%" and "&7Üye: &f%size of {team.members.%{_team}%::*}%/{@max-team-size}"

            set slot 12 of player's current inventory to name tag named "&e&l✏ TAKIM ADI" with lore "&7Takım adını değiştir."

            set slot 14 of player's current inventory to lime dye named "&a&l🎨 TAKIM RENGİ" with lore "&7Takım rengini değiştir."

            set slot 16 of player's current inventory to player head named "&b&l👥 OYUNCU DAVET ET" with lore "&7Takıma oyuncu davet et."

            set slot 22 of player's current inventory to barrier named "&c&l🚪 TAKIMDAN AYR"

        else:

            set slot 13 of player's current inventory to emerald named "&a&l⚔ TAKIM OLUŞTUR" with lore "&7Yeni bir takım oluştur."

            set slot 22 of player's current inventory to barrier named "&c&l✖ KAPAT"

# ==========================================================
# TAKIM GUI
# ==========================================================

on inventory click:

    if name of event-inventory is "&8⚔ Takım Menüsü":

        cancel event

        if clicked inventory is not event-inventory:
            stop

        # TAKIM OLUŞTUR
        if clicked slot is 13:

            if {team.%player's uuid%} is set:
                close player's inventory
                send "&e⚠ Zaten bir takımın var." to player
                stop

            set {_id} to random integer between 10000 and 99999
            set {_team} to "wt-%{_id}%"

            execute console command "team add %{_team}%"

            set {team.%player's uuid%} to {_team}
            set {team.name.%{_team}%} to "TAKIM"
            set {team.color.%{_team}%} to "green"

            add player to {team.members.%{_team}%::*}

            execute console command "team join %{_team}% %player%"
            execute console command "team modify %{_team}% collisionRule never"

            close player's inventory

            send "&a&l⚔ TAKIM OLUŞTURULDU!" to player
            send "&7» Takım adı: &fTAKIM" to player

            play sound "block.beacon.activate" with volume 1 and pitch 1.2 to player
            stop

        # BİLGİ
        if clicked slot is 10:

            if {team.%player's uuid%} is not set:
                stop

            set {_team} to {team.%player's uuid%}

            close player's inventory

            send "&a&l⚔ TAKIM BİLGİLERİ" to player
            send "&7Takım adı: &f%{team.name.%{_team}%}%"
            send "&7Üyeler: &f%size of {team.members.%{_team}%::*}%/{@max-team-size}"

            loop {team.members.%{_team}%::*}:
                send "&8• &f%loop-value%" to player

            stop

        # TAKIM ADI
        if clicked slot is 12:

            if {team.%player's uuid%} is not set:
                stop

            close player's inventory

            set {team.input.%player's uuid%} to "name"

            send "&e&l✏ TAKIM ADI" to player
            send "&7Yeni takım adını chat'e yaz."
            send "&7Maksimum: &f8 karakter"
            send "&7İptal: &ciptal"
            stop

        # RENK
        if clicked slot is 14:

            if {team.%player's uuid%} is not set:
                stop

            close player's inventory

            open chest inventory with 3 rows named "&8🎨 Takım Rengi" to player

            wait 1 tick

            set slot 10 of player's current inventory to red dye named "&c&lKırmızı"
            set slot 11 of player's current inventory to orange dye named "&6&lTuruncu"
            set slot 12 of player's current inventory to yellow dye named "&e&lSarı"
            set slot 13 of player's current inventory to lime dye named "&a&lAçık Yeşil"
            set slot 14 of player's current inventory to green dye named "&2&lYeşil"
            set slot 15 of player's current inventory to cyan dye named "&b&lTurkuaz"
            set slot 16 of player's current inventory to blue dye named "&9&lMavi"
            set slot 21 of player's current inventory to purple dye named "&5&lMor"
            set slot 22 of player's current inventory to pink dye named "&d&lPembe"
            set slot 23 of player's current inventory to white dye named "&f&lBeyaz"

            stop

        # DAVET
        if clicked slot is 16:

            if {team.%player's uuid%} is not set:
                stop

            close player's inventory

            set {team.input.%player's uuid%} to "invite"

            send "&b&l👥 OYUNCU DAVET ET" to player
            send "&7Oyuncunun adını chat'e yaz."
            send "&7İptal: &ciptal"
            stop

        # AYRIL
        if clicked slot is 22:

            if {team.%player's uuid%} is not set:
                close player's inventory
                stop

            set {_team} to {team.%player's uuid%}

            execute console command "team leave %player%"

            remove player from {team.members.%{_team}%::*}

            delete {team.%player's uuid%}

            close player's inventory

            send "&c✖ Takımdan ayrıldın." to player

# ==========================================================
# TAKIM RENK MENÜSÜ
# ==========================================================

on inventory click:

    if name of event-inventory is "&8🎨 Takım Rengi":

        cancel event

        if clicked inventory is not event-inventory:
            stop

        if {team.%player's uuid%} is not set:
            close player's inventory
            stop

        set {_team} to {team.%player's uuid%}
        set {_color} to ""

        if clicked slot is 10:
            set {_color} to "red"
        else if clicked slot is 11:
            set {_color} to "gold"
        else if clicked slot is 12:
            set {_color} to "yellow"
        else if clicked slot is 13:
            set {_color} to "green"
        else if clicked slot is 14:
            set {_color} to "dark_green"
        else if clicked slot is 15:
            set {_color} to "aqua"
        else if clicked slot is 16:
            set {_color} to "blue"
        else if clicked slot is 21:
            set {_color} to "dark_purple"
        else if clicked slot is 22:
            set {_color} to "light_purple"
        else if clicked slot is 23:
            set {_color} to "white"
        else:
            stop

        set {team.color.%{_team}%} to {_color}

        close player's inventory

        send "&a✔ Takım rengi değiştirildi." to player

# ==========================================================
# /TAKIMKABUL
# ==========================================================

command /takımkabul:
    executable by: players

    trigger:

        if {team.invite.%player's uuid%} is not set:
            send "&c✖ Bekleyen bir takım davetin yok." to player
            stop

        if {team.%player's uuid%} is set:
            send "&c✖ Zaten bir takımın var." to player
            delete {team.invite.%player's uuid%}
            stop

        set {_team} to {team.invite.%player's uuid%}

        if size of {team.members.%{_team}%::*} >= {@max-team-size}:
            send "&c✖ Bu takım artık dolu." to player
            delete {team.invite.%player's uuid%}
            stop

        add player to {team.members.%{_team}%::*}
        set {team.%player's uuid%} to {_team}

        execute console command "team join %{_team}% %player%"
        execute console command "team modify %{_team}% collisionRule never"

        delete {team.invite.%player's uuid%}

        send "&a&l✔ TAKIMA KATILDIN!" to player
        send "&7Takım: &f%{team.name.%{_team}%}%"

# ==========================================================
# /ENV
# ==========================================================

command /env <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if arg-player is player:
            send "&c✖ Kendi envanterini bu komutla açamazsın." to player
            stop

        set {admin.inventory.%player's uuid%} to arg-player

        open arg-player's inventory for player

        send "&c⚡ &f%arg-player's name% &7envanteri görüntüleniyor." to player

# ==========================================================
# /ENDER
# ==========================================================

command /ender <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        if arg-player is player:
            send "&c✖ Kendi Ender Sandığını açamazsın." to player
            stop

        set {admin.ender.%player's uuid%} to arg-player

        open arg-player's ender chest to player

        send "&c⚡ &f%arg-player's name% &7Ender Sandığı görüntüleniyor." to player

# ==========================================================
# ENV / ENDER KORUMA
# ==========================================================

on inventory click:

    if {admin.inventory.%player's uuid%} is set:
        cancel event

    if {admin.ender.%player's uuid%} is set:
        cancel event

on inventory drag:

    if {admin.inventory.%player's uuid%} is set:
        cancel event

    if {admin.ender.%player's uuid%} is set:
        cancel event

on inventory close:

    delete {admin.inventory.%player's uuid%}
    delete {admin.ender.%player's uuid%}

# ==========================================================
# /BİLGİ
# ==========================================================

command /bilgi <player>:
    executable by: players

    trigger:

        if isAdmin(player) is false:
            send "&c✖ Bu komutu kullanamazsın!" to player
            stop

        set {_target} to arg-player

        if {team.%{_target}'s uuid%} is set:
            set {_team} to {team.%{_target}'s uuid%}
            set {_teamname} to {team.name.%{_team}%}
        else:
            set {_teamname} to "Takımsız"

        send ""
        send "&8&m━━━━━━━━━━━━━━━━━━━━━━━━"
        send "&c&l⚡ OYUNCU BİLGİSİ"
        send "&8&m━━━━━━━━━━━━━━━━━━━━━━━━"
        send "&7Oyuncu: &f%{_target}'s name%"
        send "&7UUID: &f%{_target}'s uuid%"
        send "&7Gamemode: &f%{_target}'s gamemode%"
        send "&7Dünya: &f%world of {_target}%"
        send "&7Ping: &f%ping of {_target}% ms"
        send "&7Can: &c%health of {_target}%&7/&c%max health of {_target}%"
        send "&7Açlık: &e%food level of {_target}%"
        send "&7Seviye: &a%level of {_target}%"
        send "&7Takım: &f%{_teamname}%"

        if {_target} is flying:
            send "&7Uçuyor: &aEvet"
        else:
            send "&7Uçuyor: &cHayır"

        if {_target} is sneaking:
            send "&7Sneak: &aEvet"
        else:
            send "&7Sneak: &cHayır"

        send ""
        send "&e&lKONUM"
        send "&7X: &f%x-coordinate of {_target}%"
        send "&7Y: &f%y-coordinate of {_target}%"
        send "&7Z: &f%z-coordinate of {_target}%"
        send "&8&m━━━━━━━━━━━━━━━━━━━━━━━━"

# ==========================================================
# BAKIM
# ==========================================================

command /bakım:
    executable by: players

    trigger:

        if isMaintenanceOwner(player) is false:
            send "&c✖ Bu komutu sadece {@maintenance-owner} kullanabilir." to player
            stop

        execute console command "whitelist on"

        send "&c&l⚙ BAKIM MODU AÇILDI" to player
        send "&7» Whitelist aktif."

command /bakımçıkar:
    executable by: players

    trigger:

        if isMaintenanceOwner(player) is false:
            send "&c✖ Bu komutu sadece {@maintenance-owner} kullanabilir." to player
            stop

        execute console command "whitelist off"

        send "&a&l⚙ BAKIM MODU KAPATILDI" to player
        send "&7» Whitelist kapatıldı."

command /bakımoyuncuekle:
    executable by: players

    trigger:

        if isMaintenanceOwner(player) is false:
            send "&c✖ Bu komutu sadece {@maintenance-owner} kullanabilir." to player
            stop

        set {maintenance.input.%player's uuid%} to true

        send "&e&l⚙ BAKIM OYUNCU EKLE" to player
        send "&7Oyuncu adını chat'e yaz."
        send "&7İptal: &ciptal"

# ==========================================================
# /HOME
# ==========================================================

command /home:
    executable by: players

    trigger:

        open chest inventory with 3 rows named "&8&lHOME &6&lMENÜ" to player

        wait 1 tick

        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to orange stained glass pane named "&6&lHOME"

        set slot 4 of player's current inventory to orange concrete named "&6&lSON GÜNCELLEMELER"

        if {home.%player's uuid%} is set:

            set slot 11 of player's current inventory to orange concrete named "&6&lHOME KONUMUNU GÜNCELLE"
            set slot 13 of player's current inventory to compass named "&6&lHOME'A GİT"
            set slot 15 of player's current inventory to paper named "&6&lHOME BİLGİSİ"
            set slot 16 of player's current inventory to red concrete named "&c&lHOME SİL"

        else:

            set slot 11 of player's current inventory to orange concrete named "&6&lHOME OLUŞTUR"
            set slot 13 of player's current inventory to gray dye named "&7&lHOME YOK"
            set slot 15 of player's current inventory to gray dye named "&7&lHOME BİLGİSİ"
            set slot 16 of player's current inventory to gray dye named "&7&lHOME SİL"

        set slot 14 of player's current inventory to barrier named "&c&lKAPAT"

# ==========================================================
# /SONGUNCELLEMELER
# ==========================================================

command /songuncellemeler:
    executable by: players

    trigger:

        open chest inventory with 3 rows named "&8&lWASTTRY &6&lGÜNCELLEMELER" to player

        wait 1 tick

        loop 27 times:
            set slot (loop-number - 1) of player's current inventory to orange stained glass pane named "&6&lWASTTRY"

        set slot 10 of player's current inventory to emerald named "&a&lTAKIM SİSTEMİ" with lore "&7• Maksimum {@max-team-size} kişi" and "&7• Takım daveti" and "&7• Takım renkleri"

        set slot 12 of player's current inventory to chest named "&6&lHOME SİSTEMİ" with lore "&7• Tek home" and "&7• Home GUI" and "&7• Home ışınlanma"

        set slot 14 of player's current inventory to ender chest named "&5&lADMIN ARAÇLARI" with lore "&7• /env" and "&7• /ender" and "&7• /bilgi"

        set slot 16 of player's current inventory to paper named "&c&lMODERASYON" with lore "&7• Mute" and "&7• Admin uyarısı" and "&7• Bakım sistemi"

        set slot 13 of player's current inventory to golden apple named "&e&lSON SÜRÜM" with lore "&7WastTry Admin System"

        set slot 22 of player's current inventory to barrier named "&c&lGERİ"

# ==========================================================
# HOME GUI
# ==========================================================

on inventory click:

    if name of event-inventory is "&8&lHOME &6&lMENÜ":

        cancel event

        if clicked inventory is not event-inventory:
            stop

        if clicked slot is 4:

            close player's inventory
            execute player command "/songuncellemeler"
            stop

        if clicked slot is 11:

            set {home.%player's uuid%} to location of player

            close player's inventory

            send "&6&l⌂ HOME KAYDEDİLDİ" to player
            play sound "block.note_block.pling" with volume 1 and pitch 1.2 to player
            stop

        if clicked slot is 13:

            if {home.%player's uuid%} is not set:
                send "&c✖ Önce bir home oluşturmalısın." to player
                stop

            set {_home} to {home.%player's uuid%}

            close player's inventory

            teleport player to {_home}

            send "&6&l⌂ HOME'A IŞINLANDIN" to player
            play sound "entity.enderman.teleport" with volume 1 and pitch 1 to player
            stop

        if clicked slot is 15:

            if {home.%player's uuid%} is not set:
                send "&c✖ Kayıtlı bir home yok." to player
                stop

            set {_home} to {home.%player's uuid%}

            send "&6&l⌂ HOME BİLGİSİ" to player
            send "&7Dünya: &f%world of {_home}%"
            send "&7X: &f%x-coordinate of {_home}%"
            send "&7Y: &f%y-coordinate of {_home}%"
            send "&7Z: &f%z-coordinate of {_home}%"
            stop

        if clicked slot is 16:

            if {home.%player's uuid%} is not set:
                send "&c✖ Silinecek home yok." to player
                stop

            delete {home.%player's uuid%}

            close player's inventory

            send "&c✖ Home silindi." to player
            stop

        if clicked slot is 14:

            close player's inventory
            stop

# ==========================================================
# GÜNCELLEMELER GUI
# ==========================================================

on inventory click:

    if name of event-inventory is "&8&lWASTTRY &6&lGÜNCELLEMELER":

        cancel event

        if clicked inventory is not event-inventory:
            stop

        if clicked slot is 22:

            close player's inventory
            execute player command "/home"

# ==========================================================
# ESKİ HOME KOMUTLARI
# ==========================================================

on command "/sethome":
    cancel event
    send "&c✖ Home işlemleri &6/home &cmenüsünden yapılabilir."

on command "/delhome":
    cancel event
    send "&c✖ Home işlemleri &6/home &cmenüsünden yapılabilir."

on command "/homelist":
    cancel event
    send "&c✖ Sadece tek bir home kullanabilirsin."

# ==========================================================
# QUIT
# ==========================================================

on quit:

    if {admin.active.%player%} is true:

        reveal player to all players

        delete {admin.active.%player%}
        delete {admin.return.%player%}
        delete {admin.gamemode.%player%}
        delete {admin.target.%player%}

    delete {admin.inventory.%player's uuid%}
    delete {admin.ender.%player's uuid%}
    delete {team.input.%player's uuid%}
    delete {maintenance.input.%player's uuid%}

# ==========================================================
# JOIN
# ==========================================================

on join:

    delete {team.input.%player's uuid%}
    delete {maintenance.input.%player's uuid%}
